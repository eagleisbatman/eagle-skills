# ─── Colors ──────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

# ─── Helpers ─────────────────────────────────────────────────
info()    { echo -e "${BLUE}info${RESET}  $1"; }
ok()      { echo -e "${GREEN}  ok${RESET}  $1"; }
warn()    { echo -e "${YELLOW}warn${RESET}  $1"; }
err()     { echo -e "${RED} err${RESET}  $1"; }
header()  { echo -e "\n${BOLD}${MAGENTA}$1${RESET}\n"; }

banner() {
  echo -e "${BOLD}"
  cat << 'BANNER'
███████╗░█████╗░░██████╗░██╗░░░░░███████╗  ░██████╗██╗░░██╗██╗██╗░░░░░██╗░░░░░░██████╗
██╔════╝██╔══██╗██╔════╝░██║░░░░░██╔════╝  ██╔════╝██║░██╔╝██║██║░░░░░██║░░░░░██╔════╝
█████╗░░███████║██║░░██╗░██║░░░░░█████╗░░  ╚█████╗░█████═╝░██║██║░░░░░██║░░░░░╚█████╗░
██╔══╝░░██╔══██║██║░░╚██╗██║░░░░░██╔══╝░░  ░╚═══██╗██╔═██╗░██║██║░░░░░██║░░░░░░╚═══██╗
███████╗██║░░██║╚██████╔╝███████╗███████╗  ██████╔╝██║░╚██╗██║███████╗███████╗██████╔╝
╚══════╝╚═╝░░╚═╝░╚═════╝░╚══════╝╚══════╝  ╚═════╝░╚═╝░░╚═╝╚═╝╚══════╝╚══════╝╚═════╝
BANNER
  echo -e "${RESET}"
}

check_git() {
  if ! command -v git &>/dev/null; then
    err "git is required but not installed."
    exit 1
  fi
}

target_display_name() {
  case "$1" in
    claude) echo "Claude Code" ;;
    codex) echo "Codex" ;;
    grok) echo "Grok Build" ;;
    antigravity) echo "Google Antigravity" ;;
    *) echo "$1" ;;
  esac
}

normalize_targets() {
  local raw="${1:-claude}"
  local -a normalized=()
  IFS=',' read -ra requested <<< "$raw"
  for target in "${requested[@]}"; do
    target=$(echo "$target" | tr '[:upper:]' '[:lower:]' | tr -d ' ')
    case "$target" in
      all)
        normalized+=("claude" "codex" "grok" "antigravity")
        ;;
      claude|claude-code)
        normalized+=("claude")
        ;;
      codex|openai-codex)
        normalized+=("codex")
        ;;
      grok|grog|grok-build|grogbuild)
        normalized+=("grok")
        ;;
      antigravity|anti-gravity|google-antigravity)
        normalized+=("antigravity")
        ;;
      "")
        ;;
      *)
        err "Unknown target: $target"
        echo "  Valid targets: claude, codex, grok, antigravity, all"
        exit 1
        ;;
    esac
  done

  TARGETS=()
  local seen=" "
  for target in "${normalized[@]}"; do
    if [[ "$seen" != *" $target "* ]]; then
      TARGETS+=("$target")
      seen+="$target "
    fi
  done

  if [ ${#TARGETS[@]} -eq 0 ]; then
    TARGETS=("claude")
  fi
}

parse_target_args() {
  POSITIONAL_ARGS=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --target|-t)
        if [ $# -lt 2 ]; then
          err "--target requires a value"
          exit 1
        fi
        TARGET_SELECTION="$2"
        shift 2
        ;;
      --target=*)
        TARGET_SELECTION="${1#--target=}"
        shift
        ;;
      --all-targets)
        TARGET_SELECTION="all"
        shift
        ;;
      *)
        POSITIONAL_ARGS+=("$1")
        shift
        ;;
    esac
  done
  normalize_targets "$TARGET_SELECTION"
}

target_skill_dirs() {
  case "$1" in
    claude)
      echo "$HOME/.claude/skills"
      ;;
    codex)
      echo "$HOME/.codex/skills"
      ;;
    grok)
      echo "$HOME/.grok/skills"
      ;;
    antigravity)
      echo "$HOME/.gemini/config/skills"
      echo "$HOME/.gemini/antigravity-ide/skills"
      ;;
  esac
}

target_agent_dirs() {
  case "$1" in
    claude)
      echo "$HOME/.claude/agents"
      ;;
    grok)
      # Grok Build discovers Claude-compatible agent definitions today.
      echo "$HOME/.claude/agents"
      ;;
  esac
}

target_supports_agents() {
  case "$1" in
    claude|grok) return 0 ;;
    *) return 1 ;;
  esac
}

ensure_target_dirs() {
  local target="$1"
  while IFS= read -r dir; do
    [ -z "$dir" ] && continue
    mkdir -p "$dir"
  done < <(target_skill_dirs "$target")

  while IFS= read -r dir; do
    [ -z "$dir" ] && continue
    mkdir -p "$dir"
  done < <(target_agent_dirs "$target")
}

print_targets() {
  local names=()
  for target in "${TARGETS[@]}"; do
    names+=("$(target_display_name "$target")")
  done
  local IFS=", "
  echo "${names[*]}"
}

# ─── Selection menu ──────────────────────────────────────────
select_items() {
  local -a selected_skills=()
  local -a selected_agents=()
  local skill_count=${#SKILL_DIRS[@]}
  local agent_count=${#AGENT_FILES[@]}
  local total=$((skill_count + agent_count))

  banner
  echo -e "  ${DIM}Select skills and agents to install${RESET}"
  echo ""

  echo -e "  ${BOLD}Skills${RESET} ${DIM}(installed for $(print_targets))${RESET}"
  echo ""
  for i in "${!SKILL_DIRS[@]}"; do
    local num=$((i + 1))
    echo -e "    ${CYAN}${num}${RESET}  ${BOLD}${SKILL_NAMES[$i]}${RESET}"
    echo -e "       ${DIM}${SKILL_DESCS[$i]}${RESET}"
    echo ""
  done

  echo -e "  ${BOLD}Agents${RESET} ${DIM}(Claude Code and Grok Build targets only)${RESET}"
  echo ""
  for i in "${!AGENT_FILES[@]}"; do
    local num=$((skill_count + i + 1))
    local category="${AGENT_CATEGORIES[$i]}"
    local tag=""
    case "$category" in
      orchestrator) tag="${MAGENTA}orchestrator${RESET}" ;;
      lifecycle)    tag="${BLUE}lifecycle${RESET}" ;;
      review)       tag="${GREEN}review${RESET}" ;;
    esac
    echo -e "    ${CYAN}${num}${RESET}  ${BOLD}${AGENT_NAMES[$i]}${RESET}  ${DIM}[${tag}${DIM}]${RESET}"
    echo -e "       ${DIM}${AGENT_DESCS[$i]}${RESET}"
    echo ""
  done

  echo -e "    ${CYAN}a${RESET}  ${BOLD}All skills and agents${RESET}"
  echo ""

  read -rp "  Select items to install (e.g. 1,3,8 or a for all): " choice

  if [[ "$choice" =~ ^[Aa]$ ]]; then
    selected_skills=("${SKILL_DIRS[@]}")
    selected_agents=("${AGENT_FILES[@]}")
  else
    IFS=',' read -ra nums <<< "$choice"
    for num in "${nums[@]}"; do
      num=$(echo "$num" | tr -d ' ')
      if [[ "$num" =~ ^[0-9]+$ ]] && [ "$num" -ge 1 ] && [ "$num" -le "$total" ]; then
        if [ "$num" -le "$skill_count" ]; then
          selected_skills+=("${SKILL_DIRS[$((num - 1))]}")
        else
          local agent_idx=$((num - skill_count - 1))
          selected_agents+=("${AGENT_FILES[$agent_idx]}")
        fi
      else
        warn "Skipping invalid selection: $num"
      fi
    done
  fi

  if [ ${#selected_skills[@]} -eq 0 ] && [ ${#selected_agents[@]} -eq 0 ]; then
    err "No items selected."
    exit 1
  fi

  SELECTED_SKILLS=("${selected_skills[@]+"${selected_skills[@]}"}")
  SELECTED_AGENTS=("${selected_agents[@]+"${selected_agents[@]}"}")
}

# ─── Commands ────────────────────────────────────────────────

install_skill_to_dir() {
  local skill="$1"
  local dst_root="$2"
  local src="$INSTALL_DIR/$skill"
  local dst="$dst_root/$skill"

  if [ ! -d "$src" ]; then
    warn "Skill directory not found: $src (skipping)"
    return 1
  fi

  if [ -L "$dst" ]; then
    rm "$dst"
  elif [ -d "$dst" ]; then
    warn "$dst exists and is not a symlink. Overwrite? [y/N]"
    read -rp "  " answer
    if [[ "$answer" =~ ^[Yy]$ ]]; then
      rm -rf "$dst"
    else
      warn "Skipping $skill"
      return 1
    fi
  fi

  ln -sf "$src" "$dst"
  return 0
}

install_agent_to_dir() {
  local agent="$1"
  local dst_root="$2"
  local src="$INSTALL_DIR/agents/${agent}.md"
  local dst="$dst_root/${agent}.md"

  if [ ! -f "$src" ]; then
    warn "Agent file not found: $src (skipping)"
    return 1
  fi

  if [ -L "$dst" ]; then
    rm "$dst"
  elif [ -f "$dst" ]; then
    warn "$dst exists and is not a symlink. Overwrite? [y/N]"
    read -rp "  " answer
    if [[ "$answer" =~ ^[Yy]$ ]]; then
      rm -f "$dst"
    else
      warn "Skipping $agent"
      return 1
    fi
  fi

  ln -sf "$src" "$dst"
  return 0
}

cmd_install() {
  check_git

  for target in "${TARGETS[@]}"; do
    ensure_target_dirs "$target"
  done

  select_items

  echo ""

  # Clone or update the repo
  if [ -d "$INSTALL_DIR/.git" ]; then
    info "Updating existing clone at $INSTALL_DIR"
    git -C "$INSTALL_DIR" pull --quiet
    ok "Repository updated"
  else
    info "Cloning eagle-skills to $INSTALL_DIR"
    git clone --quiet "$REPO_URL" "$INSTALL_DIR"
    ok "Repository cloned"
  fi

  local count=0

  for target in "${TARGETS[@]}"; do
    header "Installing for $(target_display_name "$target")"

    while IFS= read -r skills_dir; do
      [ -z "$skills_dir" ] && continue
      for skill in "${SELECTED_SKILLS[@]+"${SELECTED_SKILLS[@]}"}"; do
        [ -z "$skill" ] && continue
        if install_skill_to_dir "$skill" "$skills_dir"; then
          ok "Installed skill ${BOLD}$(skill_display_name "$skill")${RESET} -> $skills_dir"
          count=$((count + 1))
        fi
      done
    done < <(target_skill_dirs "$target")

    if target_supports_agents "$target"; then
      while IFS= read -r agents_dir; do
        [ -z "$agents_dir" ] && continue
        for agent in "${SELECTED_AGENTS[@]+"${SELECTED_AGENTS[@]}"}"; do
          [ -z "$agent" ] && continue
          if install_agent_to_dir "$agent" "$agents_dir"; then
            ok "Installed agent ${BOLD}$(agent_display_name "$agent")${RESET} -> $agents_dir"
            count=$((count + 1))
          fi
        done
      done < <(target_agent_dirs "$target")
    elif [ ${#SELECTED_AGENTS[@]} -gt 0 ]; then
      warn "$(target_display_name "$target") does not support Eagle agent files yet; skills were installed."
    fi
  done

  echo ""
  if [ "$count" -gt 0 ]; then
    echo -e "  ${GREEN}${BOLD}$count item(s) installed.${RESET}"
    echo -e "  ${DIM}Items are symlinked — run ${RESET}eagle-skills update${DIM} to get the latest.${RESET}"
  else
    warn "No items were installed."
  fi
  echo ""
}

cmd_update() {
  if [ ! -d "$INSTALL_DIR/.git" ]; then
    err "Eagle Skills not found at $INSTALL_DIR"
    echo -e "  ${DIM}Run ${RESET}eagle-skills install${DIM} first.${RESET}"
    exit 1
  fi

  header "Updating Eagle Skills"

  local before
  before=$(git -C "$INSTALL_DIR" rev-parse HEAD)
  git -C "$INSTALL_DIR" pull --quiet
  local after
  after=$(git -C "$INSTALL_DIR" rev-parse HEAD)

  if [ "$before" = "$after" ]; then
    ok "Already up to date."
  else
    local changes
    changes=$(git -C "$INSTALL_DIR" log --oneline "$before..$after" | wc -l | tr -d ' ')
    ok "Updated ($changes new commit(s))"
    echo ""
    echo -e "  ${DIM}Recent changes:${RESET}"
    git -C "$INSTALL_DIR" log --oneline "$before..$after" | head -10 | while read -r line; do
      echo -e "    ${DIM}$line${RESET}"
    done
  fi

  # Verify symlinks still work for selected targets
  echo ""
  local broken=0
  for target in "${TARGETS[@]}"; do
    echo -e "  ${BOLD}$(target_display_name "$target")${RESET}"
    while IFS= read -r skills_dir; do
      [ -z "$skills_dir" ] && continue
      for skill in "${SKILL_DIRS[@]}"; do
        local dst="$skills_dir/$skill"
        if [ -L "$dst" ]; then
          if [ -d "$dst" ]; then
            ok "$skill"
          else
            err "$skill — broken symlink"
            broken=$((broken + 1))
          fi
        fi
      done
    done < <(target_skill_dirs "$target")

    while IFS= read -r agents_dir; do
      [ -z "$agents_dir" ] && continue
      for agent in "${AGENT_FILES[@]}"; do
        local dst="$agents_dir/${agent}.md"
        if [ -L "$dst" ]; then
          if [ -f "$dst" ]; then
            ok "$agent"
          else
            err "$agent — broken symlink"
            broken=$((broken + 1))
          fi
        fi
      done
    done < <(target_agent_dirs "$target")
  done

  if [ "$broken" -gt 0 ]; then
    warn "$broken broken symlink(s). Run ${RESET}eagle-skills install${DIM} to fix.${RESET}"
  fi
  echo ""
}

cmd_status() {
  header "Eagle Skills — Status"

  # Check install directory
  if [ -d "$INSTALL_DIR/.git" ]; then
    local commit
    commit=$(git -C "$INSTALL_DIR" log --oneline -1)
    ok "Repo: $INSTALL_DIR"
    echo -e "     ${DIM}$commit${RESET}"

    # Check for updates
    git -C "$INSTALL_DIR" fetch --quiet 2>/dev/null || true
    local local_rev remote_rev
    local_rev=$(git -C "$INSTALL_DIR" rev-parse HEAD)
    remote_rev=$(git -C "$INSTALL_DIR" rev-parse '@{u}' 2>/dev/null || echo "$local_rev")
    if [ "$local_rev" != "$remote_rev" ]; then
      local behind
      behind=$(git -C "$INSTALL_DIR" rev-list --count HEAD..'@{u}' 2>/dev/null || echo "?")
      warn "Update available ($behind commit(s) behind)"
    fi
  else
    warn "Not installed. Run: eagle-skills install"
    return
  fi

  echo ""

  for target in "${TARGETS[@]}"; do
    echo -e "  ${BOLD}$(target_display_name "$target")${RESET}"
    echo ""

    local installed_skills=0
    local skill_slots=0
    echo -e "    ${BOLD}Skills:${RESET}"
    while IFS= read -r skills_dir; do
      [ -z "$skills_dir" ] && continue
      echo -e "      ${DIM}$skills_dir${RESET}"
      for i in "${!SKILL_DIRS[@]}"; do
        local skill="${SKILL_DIRS[$i]}"
        local dst="$skills_dir/$skill"
        skill_slots=$((skill_slots + 1))
        if [ -L "$dst" ] && [ -d "$dst" ]; then
          echo -e "        ${GREEN}*${RESET} ${BOLD}${SKILL_NAMES[$i]}${RESET}"
          echo -e "          ${DIM}-> $(readlink "$dst")${RESET}"
          installed_skills=$((installed_skills + 1))
        elif [ -L "$dst" ]; then
          echo -e "        ${RED}!${RESET} ${BOLD}${SKILL_NAMES[$i]}${RESET} ${RED}(broken symlink)${RESET}"
        elif [ -d "$dst" ]; then
          echo -e "        ${YELLOW}~${RESET} ${BOLD}${SKILL_NAMES[$i]}${RESET} ${YELLOW}(copied, not symlinked)${RESET}"
          installed_skills=$((installed_skills + 1))
        else
          echo -e "        ${DIM}-${RESET} ${DIM}${SKILL_NAMES[$i]}${RESET} ${DIM}(not installed)${RESET}"
        fi
      done
    done < <(target_skill_dirs "$target")
    echo -e "      ${DIM}$installed_skills of $skill_slots skill slots installed${RESET}"

    local installed_agents=0
    local agent_slots=0
    if target_supports_agents "$target"; then
      echo ""
      echo -e "    ${BOLD}Agents:${RESET}"
      while IFS= read -r agents_dir; do
        [ -z "$agents_dir" ] && continue
        echo -e "      ${DIM}$agents_dir${RESET}"
        for i in "${!AGENT_FILES[@]}"; do
          local agent="${AGENT_FILES[$i]}"
          local dst="$agents_dir/${agent}.md"
          agent_slots=$((agent_slots + 1))
          if [ -L "$dst" ] && [ -f "$dst" ]; then
            echo -e "        ${GREEN}*${RESET} ${BOLD}${AGENT_NAMES[$i]}${RESET}"
            echo -e "          ${DIM}-> $(readlink "$dst")${RESET}"
            installed_agents=$((installed_agents + 1))
          elif [ -L "$dst" ]; then
            echo -e "        ${RED}!${RESET} ${BOLD}${AGENT_NAMES[$i]}${RESET} ${RED}(broken symlink)${RESET}"
          elif [ -f "$dst" ]; then
            echo -e "        ${YELLOW}~${RESET} ${BOLD}${AGENT_NAMES[$i]}${RESET} ${YELLOW}(copied, not symlinked)${RESET}"
            installed_agents=$((installed_agents + 1))
          else
            echo -e "        ${DIM}-${RESET} ${DIM}${AGENT_NAMES[$i]}${RESET} ${DIM}(not installed)${RESET}"
          fi
        done
      done < <(target_agent_dirs "$target")
      echo -e "      ${DIM}$installed_agents of $agent_slots agent slots installed${RESET}"
    else
      echo ""
      echo -e "    ${DIM}Agent files are not supported for this target; install Eagle Spectral Review as a skill.${RESET}"
    fi
    echo ""
  done
  echo ""
}

cmd_uninstall() {
  header "Uninstall Eagle Skills"

  local removed=0

  for target in "${TARGETS[@]}"; do
    header "Removing from $(target_display_name "$target")"

    while IFS= read -r skills_dir; do
      [ -z "$skills_dir" ] && continue
      for i in "${!SKILL_DIRS[@]}"; do
        local skill="${SKILL_DIRS[$i]}"
        local dst="$skills_dir/$skill"
        if [ -L "$dst" ]; then
          rm "$dst"
          ok "Removed skill ${SKILL_NAMES[$i]} from $skills_dir"
          removed=$((removed + 1))
        elif [ -d "$dst" ]; then
          read -rp "  Remove ${SKILL_NAMES[$i]} from $skills_dir (not a symlink — will delete)? [y/N] " answer
          if [[ "$answer" =~ ^[Yy]$ ]]; then
            rm -rf "$dst"
            ok "Removed skill ${SKILL_NAMES[$i]} from $skills_dir"
            removed=$((removed + 1))
          fi
        fi
      done
    done < <(target_skill_dirs "$target")

    while IFS= read -r agents_dir; do
      [ -z "$agents_dir" ] && continue
      for i in "${!AGENT_FILES[@]}"; do
        local agent="${AGENT_FILES[$i]}"
        local dst="$agents_dir/${agent}.md"
        if [ -L "$dst" ]; then
          rm "$dst"
          ok "Removed agent ${AGENT_NAMES[$i]} from $agents_dir"
          removed=$((removed + 1))
        elif [ -f "$dst" ]; then
          read -rp "  Remove ${AGENT_NAMES[$i]} from $agents_dir (not a symlink — will delete)? [y/N] " answer
          if [[ "$answer" =~ ^[Yy]$ ]]; then
            rm -f "$dst"
            ok "Removed agent ${AGENT_NAMES[$i]} from $agents_dir"
            removed=$((removed + 1))
          fi
        fi
      done
    done < <(target_agent_dirs "$target")
  done

  if [ "$removed" -eq 0 ]; then
    info "No items were installed."
  else
    ok "$removed item(s) removed."
  fi

  # Optionally remove the clone
  if [ -d "$INSTALL_DIR" ]; then
    echo ""
    read -rp "  Also remove the cloned repo at $INSTALL_DIR? [y/N] " answer
    if [[ "$answer" =~ ^[Yy]$ ]]; then
      rm -rf "$INSTALL_DIR"
      ok "Repo removed."
    fi
  fi
  echo ""
}

skill_display_name() {
  local dir="$1"
  for i in "${!SKILL_DIRS[@]}"; do
    if [ "${SKILL_DIRS[$i]}" = "$dir" ]; then
      echo "${SKILL_NAMES[$i]}"
      return
    fi
  done
  echo "$dir"
}

agent_display_name() {
  local file="$1"
  for i in "${!AGENT_FILES[@]}"; do
    if [ "${AGENT_FILES[$i]}" = "$file" ]; then
      echo "${AGENT_NAMES[$i]}"
      return
    fi
  done
  echo "$file"
}

# ─── Usage command ──────────────────────────────────────────

print_skill_usage() {
  local i="$1"
  echo -e "  ${BOLD}${MAGENTA}${SKILL_NAMES[$i]}${RESET}"
  echo ""
  echo -e "    ${BOLD}Slash command:${RESET}  ${CYAN}${SKILL_COMMANDS[$i]}${RESET}"
  echo -e "    ${BOLD}Trigger with:${RESET}   ${DIM}${SKILL_TRIGGERS[$i]}${RESET}"
  echo ""
  echo -e "    ${BOLD}Required inputs:${RESET}"
  local shown_optional=false
  IFS='|' read -ra items <<< "${SKILL_INPUTS[$i]}"
  for item in "${items[@]}"; do
    item=$(echo "$item" | sed 's/^ *//')
    if [[ "$item" == Optional:* ]]; then
      if [ "$shown_optional" = false ]; then
        echo ""
        echo -e "    ${BOLD}Optional inputs:${RESET}"
        shown_optional=true
      fi
      item="${item#Optional: }"
      echo -e "      ${DIM}-${RESET} $item"
    else
      echo -e "      ${DIM}-${RESET} $item"
    fi
  done
  echo ""
  echo -e "    ${BOLD}Output:${RESET}"
  echo -e "      ${SKILL_OUTPUTS[$i]}"
  echo ""
  echo -e "    ${BOLD}Example:${RESET}"
  echo -e "      ${DIM}You:${RESET} ${SKILL_EXAMPLES[$i]}"
  echo ""
}

print_agent_usage() {
  local i="$1"
  local category="${AGENT_CATEGORIES[$i]}"
  local tag=""
  case "$category" in
    orchestrator) tag="${MAGENTA}orchestrator${RESET}" ;;
    lifecycle)    tag="${BLUE}lifecycle${RESET}" ;;
    review)       tag="${GREEN}review${RESET}" ;;
  esac
  echo -e "  ${BOLD}${MAGENTA}${AGENT_NAMES[$i]}${RESET}  ${DIM}[${tag}${DIM}]${RESET}"
  echo ""
  echo -e "    ${BOLD}Agent name:${RESET}  ${CYAN}${AGENT_FILES[$i]}${RESET}"
  echo -e "    ${BOLD}Category:${RESET}    ${DIM}${category}${RESET}"
  echo ""
  echo -e "    ${BOLD}Description:${RESET}"
  echo -e "      ${AGENT_DESCS[$i]}"
  echo ""
  echo -e "    ${BOLD}Invoke:${RESET}"
  echo -e "      ${DIM}Claude Code and Grok Build can dispatch this agent by name,${RESET}"
  echo -e "      ${DIM}or you can ask: \"run ${AGENT_FILES[$i]}\"${RESET}"
  echo ""
}

cmd_usage() {
  local filter="${1:-}"

  header "Eagle Skills — How to Use"

  # Determine which items to show
  local -a show_skill_indices=()
  local -a show_agent_indices=()
  local has_installed=false

  if [ -n "$filter" ]; then
    local found=false
    for i in "${!SKILL_DIRS[@]}"; do
      if [ "${SKILL_DIRS[$i]}" = "$filter" ] || [ "${SKILL_COMMANDS[$i]}" = "/$filter" ] || [ "${SKILL_COMMANDS[$i]}" = "$filter" ]; then
        show_skill_indices+=("$i")
        found=true
        break
      fi
    done
    if [ "$found" = false ]; then
      for i in "${!AGENT_FILES[@]}"; do
        if [ "${AGENT_FILES[$i]}" = "$filter" ]; then
          show_agent_indices+=("$i")
          found=true
          break
        fi
      done
    fi
    if [ "$found" = false ]; then
      err "Unknown skill or agent: $filter"
      echo -e "  ${DIM}Skills: ${SKILL_DIRS[*]}${RESET}"
      echo -e "  ${DIM}Agents: ${AGENT_FILES[*]}${RESET}"
      echo ""
      return 1
    fi
  else
    local seen_skills=" "
    local seen_agents=" "
    for target in "${TARGETS[@]}"; do
      while IFS= read -r skills_dir; do
        [ -z "$skills_dir" ] && continue
        for i in "${!SKILL_DIRS[@]}"; do
          local dst="$skills_dir/${SKILL_DIRS[$i]}"
          if { [ -L "$dst" ] && [ -d "$dst" ]; } || [ -d "$dst" ]; then
            if [[ "$seen_skills" != *" $i "* ]]; then
              show_skill_indices+=("$i")
              seen_skills+="$i "
            fi
            has_installed=true
          fi
        done
      done < <(target_skill_dirs "$target")

      while IFS= read -r agents_dir; do
        [ -z "$agents_dir" ] && continue
        for i in "${!AGENT_FILES[@]}"; do
          local dst="$agents_dir/${AGENT_FILES[$i]}.md"
          if { [ -L "$dst" ] && [ -f "$dst" ]; } || [ -f "$dst" ]; then
            if [[ "$seen_agents" != *" $i "* ]]; then
              show_agent_indices+=("$i")
              seen_agents+="$i "
            fi
            has_installed=true
          fi
        done
      done < <(target_agent_dirs "$target")
    done

    if [ ${#show_skill_indices[@]} -eq 0 ] && [ ${#show_agent_indices[@]} -eq 0 ]; then
      echo -e "  ${DIM}Nothing installed. Showing all available items.${RESET}"
      echo -e "  ${DIM}Run ${RESET}eagle-skills install${DIM} to get started.${RESET}"
      echo ""
      for i in "${!SKILL_DIRS[@]}"; do show_skill_indices+=("$i"); done
      for i in "${!AGENT_FILES[@]}"; do show_agent_indices+=("$i"); done
    else
      local total=$(( ${#show_skill_indices[@]} + ${#show_agent_indices[@]} ))
      echo -e "  ${DIM}Showing $total installed item(s) for $(print_targets). Run ${RESET}eagle-skills usage <name>${DIM} for details on one.${RESET}"
      echo ""
    fi
  fi

  if [ ${#show_skill_indices[@]} -gt 0 ]; then
    echo -e "  ${BOLD}${CYAN}── Skills ──${RESET}"
    echo ""
    for i in "${show_skill_indices[@]}"; do
      print_skill_usage "$i"
    done
  fi

  if [ ${#show_agent_indices[@]} -gt 0 ]; then
    echo -e "  ${BOLD}${CYAN}── Agents ──${RESET}"
    echo ""
    for i in "${show_agent_indices[@]}"; do
      print_agent_usage "$i"
    done
  fi

  echo -e "  ${DIM}────────────────────────────────────────────────${RESET}"
  echo ""
  echo -e "  ${BOLD}Tips:${RESET}"
  echo -e "    ${DIM}-${RESET} Skills activate when an agent detects matching intent, or invoke with slash commands"
  echo -e "    ${DIM}-${RESET} Agent files work in Claude Code and Grok Build — ask the agent to run one by name"
  echo -e "    ${DIM}-${RESET} Ask for specific review agents by name, or describe what you need"
  echo ""
}

cmd_govern() {
  local targets
  local IFS=","
  targets="${TARGETS[*]}"
  EAGLE_SKILLS_SOURCE_DIR="$SOURCE_DIR" EAGLE_SKILLS_TARGETS="$targets" bash "$SOURCE_DIR/scripts/govern.sh" "${POSITIONAL_ARGS[@]+"${POSITIONAL_ARGS[@]}"}"
}

cmd_help() {
  banner
  echo -e "  ${BOLD}Eagle Skills${RESET} v${VERSION}"
  echo -e "  ${DIM}Skills and agents for Claude Code, Codex, Grok Build, and Antigravity${RESET}"
  echo ""
  echo -e "${BOLD}Usage:${RESET}"
  echo "  eagle-skills <command> [--target claude|codex|grok|antigravity|all]"
  echo ""
  echo -e "${BOLD}Commands:${RESET}"
  echo "  install     Select and install skills and agents"
  echo "  update      Pull latest changes (symlinked items update automatically)"
  echo "  status      Show installed skills/agents and check for updates"
  echo "  usage       Show how to use installed items (inputs, outputs, examples)"
  echo "  uninstall   Remove installed skills and agents"
  echo "  govern      Install and verify hook-based project governance"
  echo "  help        Show this help message"
  echo ""
  echo -e "${BOLD}Quick start:${RESET}"
  echo "  npx eagle-skills install"
  echo "  npx eagle-skills install --target all"
  echo "  npx eagle-skills govern apply --target all --mode warn"
  echo ""
  echo -e "${BOLD}Alternative (without npm):${RESET}"
  echo "  curl -fsSL https://raw.githubusercontent.com/eagleisbatman/eagle-skills/main/install.sh | bash"
  echo ""

  echo -e "${BOLD}Skills${RESET} ${DIM}(${#SKILL_DIRS[@]} — invoked via slash commands)${RESET}"
  echo ""
  for i in "${!SKILL_DIRS[@]}"; do
    echo -e "  ${BOLD}$((i + 1)).${RESET} ${CYAN}${SKILL_COMMANDS[$i]}${RESET}"
    echo -e "     ${DIM}${SKILL_DESCS[$i]}${RESET}"
  done
  echo ""

  echo -e "${BOLD}Agents${RESET} ${DIM}(${#AGENT_FILES[@]} — dispatched by Claude Code and Grok Build)${RESET}"
  echo ""
  for i in "${!AGENT_FILES[@]}"; do
    echo -e "  ${BOLD}$((i + 1)).${RESET} ${CYAN}${AGENT_FILES[$i]}${RESET}"
    echo -e "     ${DIM}${AGENT_DESCS[$i]}${RESET}"
  done
  echo ""
}

# ─── Main ────────────────────────────────────────────────────
main() {
  local cmd="${1:-help}"
  if [ "$#" -gt 0 ]; then
    shift
  fi

  parse_target_args "$@"

  case "$cmd" in
    install)   cmd_install ;;
    update)    cmd_update ;;
    status)    cmd_status ;;
    usage)     cmd_usage "${POSITIONAL_ARGS[0]:-}" ;;
    uninstall) cmd_uninstall ;;
    govern)    cmd_govern ;;
    help|--help|-h) cmd_help ;;
    version|--version|-v) echo "eagle-skills v${VERSION}" ;;
    *)
      err "Unknown command: $cmd"
      cmd_help
      exit 1
      ;;
  esac
}

main "$@"
